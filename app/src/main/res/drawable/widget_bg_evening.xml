<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFF0DD"
                android:startColor="#E7D7FF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#CDB7F0" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/widget_decor_glow_lilac"
        android:gravity="top|end"
        android:right="-20dp"
        android:top="-20dp" />
</layer-list>
